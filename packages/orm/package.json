{
  "name": "@varasto/orm",
  "version": "0.6.0",
  "description": "Simple ORM which uses Varasto as it's backend",
  "license": "MIT",
  "keywords": [
    "orm",
    "varasto"
  ],
  "author": "Rauli Laine <rauli.laine@iki.fi>",
  "type": "module",
  "main": "./dist/index.js",
  "main:src": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist"
  ],
  "engines": {
    "node": ">=22.0"
  },
  "homepage": "https://rauli.dev/varasto",
  "repository": {
    "type": "git",
    "url": "https://github.com/RauliL/varasto"
  },
  "bugs": {
    "url": "https://github.com/RauliL/varasto/issues"
  },
  "scripts": {
    "clean": "rimraf './dist'",
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint './src/**/*.ts'",
    "format": "prettier --write './src'",
    "format:check": "prettier --check './src'",
    "test": "vitest run",
    "prebuild": "$npm_execpath run clean",
    "prepack": "$npm_execpath run build"
  },
  "dependencies": {
    "@varasto/query": "workspace:^",
    "reflect-metadata": "^0.2.2",
    "slugify": "^1.6.9",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@varasto/memory-storage": "workspace:^",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "it-all": "^3.0.11",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^5.0.0"
  }
}
