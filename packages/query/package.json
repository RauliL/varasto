{
  "name": "@varasto/query",
  "version": "3.0.0",
  "description": "Query and bulk operation utilities for Varasto storage",
  "license": "MIT",
  "keywords": [
    "varasto",
    "query",
    "util"
  ],
  "author": "Rauli Laine <rauli.laine@iki.fi>",
  "main": "./dist/index.js",
  "main:src": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist"
  ],
  "engines": {
    "node": ">=22.0"
  },
  "homepage": "https://rauli.dev/varasto",
  "repository": {
    "type": "git",
    "url": "https://github.com/RauliL/varasto"
  },
  "bugs": {
    "url": "https://github.com/RauliL/varasto/issues"
  },
  "scripts": {
    "clean": "rimraf './dist'",
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint './src/*.ts'",
    "format": "prettier --write './src'",
    "format:check": "prettier --check './src'",
    "test": "vitest run",
    "prebuild": "$npm_execpath run clean",
    "prepack": "$npm_execpath run build"
  },
  "dependencies": {
    "@varasto/storage": "workspace:^",
    "simple-json-match": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@varasto/memory-storage": "workspace:^",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "it-all": "^3.0.11",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
