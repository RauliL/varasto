{
  "name": "@varasto/fs-storage",
  "version": "3.0.0",
  "description": "Varasto storage implementation that stores data to hard disk",
  "license": "MIT",
  "keywords": [
    "varasto"
  ],
  "author": "Rauli Laine <rauli.laine@iki.fi>",
  "main": "./dist/index.js",
  "main:src": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist"
  ],
  "engines": {
    "node": ">=22.0"
  },
  "homepage": "https://rauli.dev/varasto",
  "repository": {
    "type": "git",
    "url": "https://github.com/RauliL/varasto"
  },
  "bugs": {
    "url": "https://github.com/RauliL/varasto/issues"
  },
  "scripts": {
    "clean": "rimraf './dist'",
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint './src/*.ts'",
    "format": "prettier --write './src'",
    "format:check": "prettier --check './src'",
    "test": "vitest run",
    "prebuild": "$npm_execpath run clean",
    "prepack": "$npm_execpath run build"
  },
  "dependencies": {
    "@varasto/storage": "workspace:^",
    "glob": "^13.0.6",
    "is-valid-slug": "^1.0.0",
    "mkdirp": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mock-fs": "^4.13.4",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "it-all": "^3.0.11",
    "mock-fs": "^5.5.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
