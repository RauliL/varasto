#!/usr/bin/env node

import { createFileSystemStorage } from '@varasto/fs-storage';
import { open } from '@varasto/url';
import yargs from 'yargs';
import { hideBin } from 'yargs/helpers';

import { repl, runCommand } from '../dist/index.js';

const args = yargs()
  .usage('$0 <url> [command]', 'Start the CLI.')
  .positional('url', {
    demand: true,
    describe: 'URL to the Varasto storage.',
    type: 'string',
  })
  .positional('command', {
    demand: false,
    describe: 'Command to execute.',
    type: 'string',
  })
  .help()
  .parse(hideBin(process.argv));

const onSuccess = () => {
  process.exit(0);
};

const onError = (err) => {
  console.error(err);
  process.exit(1);
};

(args.url.includes(':')
  ? open(args.url)
  : Promise.resolve(createFileSystemStorage({ dir: args.url }))
).then((storage) => {
  if (args.command) {
    runCommand(storage, args.command).then(onSuccess).catch(onError);
  } else {
    repl(storage);
  }
});
