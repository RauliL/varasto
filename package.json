{
  "name": "@varasto/root",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.15.0",
  "scripts": {
    "clean": "nx run-many -t clean",
    "build": "nx run-many -t build",
    "watch": "nx run-many -t watch",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "format": "nx run-many -t format",
    "format:check": "nx run-many -t format:check",
    "release": "yarn release:check && nx release --yes",
    "release:check": "yarn build && yarn test",
    "release:version": "nx release version",
    "release:publish": "nx release publish --yes --access public",
    "release:dry-run": "nx release publish --dry-run --access public"
  },
  "devDependencies": {
    "@nx/js": "^23.1.3",
    "jiti": "^2.7.0",
    "nx": "^23.2.0"
  },
  "resolutions": {
    "express": "^5.1.0",
    "node-gyp": "^11.2.0",
    "typescript": "^6.0.3"
  }
}
